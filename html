.featured-info { padding: 20px var(--sp-md); }
.featured-category {
  font-size: 11px;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 1.5px;
  font-weight: 600;
  margin-bottom: 6px;
}
.featured-title {
  font-family: var(--font-serif);
  font-size: 20px;
  color: var(--white);
  margin-bottom: var(--sp-xs);
  line-height: 1.3;
}
.featured-meta {
  display: flex;
  align-items: center;
  gap: var(--sp-sm);
  font-size: 13px;
  color: var(--muted);
  flex-wrap: wrap;
}
.featured-meta span { display: inline-flex; align-items: center; gap: 5px; }
.featured-rating { color: var(--gold); margin-left: auto; }

/* PAGE SECTIONS */
.page-section { padding: var(--sp-2xl); }
.section-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: var(--sp-lg);
  gap: var(--sp-md);
  flex-wrap: wrap;
}

/* GRIDS */
.video-grid      { display: grid; grid-template-columns: repeat(4,1fr); gap: 20px; }
.categories-grid { display: grid; grid-template-columns: repeat(6,1fr); gap: var(--sp-sm); }
.featured-row    { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 20px; }
.creators-grid   { display: grid; grid-template-columns: repeat(4,1fr); gap: 20px; }

.category-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  padding: var(--sp-md) 20px;
  text-align: center;
  text-decoration: none;
  color: inherit;
  display: block;
  transition: border-color 0.3s ease, background-color 0.3s ease, transform 0.2s ease;
}
.category-card:hover,
.category-card:focus-visible {
  border-color: var(--gold);
  background: var(--gold-dim);
  transform: translateY(-2px);
}

.creator-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  padding: 28px 20px;
  text-align: center;
  transition: border-color 0.3s ease, transform 0.2s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.creator-card:hover { border-color: rgba(201,168,76,0.3); transform: translateY(-3px); }

/* WHY GRID */
.why-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 2px;
  background: var(--border);
  border-radius: var(--r-md);
  overflow: hidden;
  margin-top: var(--sp-sm);
}
.why-card {
  background: var(--dark);
  padding: var(--sp-lg) 36px;
  transition: background-color 0.3s ease;
}
.why-card:hover { background: var(--card); }

/* CTA BANNER */
