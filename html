  color: var(--muted);
  margin-bottom: 20px;
  font-weight: 600;
}
.footer-col ul li { margin-bottom: 12px; }
.footer-col ul a {
  color: var(--white);
  text-decoration: none;
  font-size: 14px;
  transition: color 0.2s ease;
}
.footer-col ul a:hover,
.footer-col ul a:focus-visible { color: var(--gold); }
.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--sp-sm);
  padding-top: 32px;
  border-top: 1px solid var(--border);
  font-size: 13px;
  color: var(--muted);
}
.footer-legal {
